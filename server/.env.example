# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAILS=admin@stackit.local

# --- MySQL / Aiven (leave empty to use local file DB for development) ---
# Option A: full URL
# DATABASE_URL=mysql://user:password@host:port/dbname?ssl-mode=REQUIRED
# Option B: parts
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# set DB_SSL=false only for local MySQL without TLS
DB_SSL=
# Optional (recommended for production): Aiven CA certificate for full TLS verification.
# Download ca.pem from Aiven console (Overview -> Connection information) into server/certs/
DB_CA_CERT_PATH=./certs/ca.pem
# ...or paste the PEM inline:
# DB_CA_CERT=

# --- Optional image storage (Cloudinary). If empty, uploads stay on server /uploads ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
